{
  "name": "basilisk-portal",
  "private": true,
  "type": "module",
  "//types": "Read by /design-sync only. The sync converter extracts each component's prop contract from the package's declared type root; this app has no dist, so without this pointer every shipped .d.ts was `[key: string]: unknown`. `.ds-types/` is gitignored build output — regenerate with `npm run build:types` (tsconfig.dts.json). Nothing imports basilisk-portal and it is `private`, so this field is inert for Vite, vitest, `tsc --noEmit` and anything that ships to users.",
  "types": ".ds-types/ds-entry.d.ts",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "basilisk": "cli/basilisk.js"
  },
  "scripts": {
    "cli": "node cli/basilisk.js",
    "glyphs": "node scripts/build-glyphs.mjs",
    "predev": "npm run glyphs",
    "prebuild": "npm run glyphs",
    "pretest": "npm run glyphs",
    "dev": "vite",
    "build": "vite build",
    "build:types": "tsc -p tsconfig.dts.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && vitest run -c vitest.e2e.config.js"
  },
  "dependencies": {
    "@noble/curves": "^2.3.0",
    "age-encryption": "^0.3.0",
    "openpgp": "^6.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "^1.31.0",
    "playwright": "^1.62.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-sri-gen": "^1.7.3",
    "vitest": "^4.1.10"
  }
}
