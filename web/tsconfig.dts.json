// Declaration-only emit for /design-sync — NOT part of the app's build.
//
// The design-sync converter reads each component's prop contract out of the
// package's *shipped* .d.ts tree. Basilisk is an application, so no such tree
// exists and every emitted `<Name>.d.ts` shipped as `[key: string]: unknown` —
// a blank API contract for all 50 components.
//
// Why a separate tsconfig rather than flags on the main one:
//   - tsconfig.json is `noEmit: true` and `include`s all of src (plus tests).
//     A whole-project emit is ~487 files, most of them test helpers, and it
//     fails on a TS4058 in src/test/helpers/verb-smoke.js. Neither belongs in
//     a type surface that claims to describe the design system.
//   - `files: ["src/ds-entry.ts"]` makes the emitted tree exactly the
//     transitive closure of the hand-authored design-system barrel. The
//     shipped type surface is therefore the same reviewed decision that
//     ds-entry.ts already is, instead of a second, wider list that can drift.
//   - `rootDir: "src"` so .ds-types/ mirrors src/ and package.json's `types`
//     can point at .ds-types/ds-entry.d.ts — the barrel's own declaration.
//
// Output is build output: .ds-types/ is gitignored and regenerated by
// `npm run build:types`. See .design-sync/NOTES.md § Build command.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "rootDir": "src",
    "declarationDir": ".ds-types"
  },
  "files": ["src/ds-entry.ts"],
  "include": []
}
