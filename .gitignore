# Local environment / secrets (never commit)
.env
.env.local
.env.test
local.settings.json
!.env.example
!.env.test.example
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
data/
*.asc
!tests/fixtures/**/*.asc
# Throwaway OpenPGP fixtures for the JS suite, same exception as above and
# for the same reason: they are generated key material that protects nothing
# and the tests need them without a local gpg. See the README beside them.
!web/src/test/fixtures/**/*.asc
testkey.asc
marketplace/package/
*.zip
web/node_modules/
web/dist/
# The browser suite's JUnit output — one run's failures, kept so a flake that
# only shows up under load leaves something to read after the terminal scrolls.
web/test-results/

# Ephemeral agent worktrees — separate checkouts of this same repo, never
# content of it. Without this, `git add -A` commits them as gitlinks.
.claude/worktrees/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
terraform/cloudshell/backend.hcl
basilisk-fn.zip
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# design-sync (skill) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
web/.ds-styles.css
# Declaration-only emit for /design-sync (web/tsconfig.dts.json). Build output,
# not source: `cd web && npm run build:types` regenerates it in ~1s. It is the
# tree web/package.json's `types` points at, and the only reason the synced
# .d.ts files carry real props.
web/.ds-types/
