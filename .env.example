BASILISK_BASE_URL=http://localhost:8080
BASILISK_TOKEN_SECRET=change-me-in-production
BASILISK_DB_PATH=./data/basilisk.db
BASILISK_BLOB_PATH=./data/blobs
BASILISK_DEV_APPROVE=1
BASILISK_MAIL_PROVIDER=office365
BASILISK_CACHE_MODE=inline
BASILISK_LRU_CACHE=1000
BASILISK_FD_BASE_URL=
# Ingest security
BASILISK_MAX_UPLOAD_BYTES=65536
BASILISK_MAX_UIDS=20
BASILISK_MAX_SUBKEYS=32
BASILISK_REQUIRE_EMAIL_UID=1
BASILISK_REJECT_REVOKED=1
BASILISK_BLOCKED_EMAIL_DOMAINS=
BASILISK_UPLOAD_RATE_LIMIT_SEC=60
BASILISK_UPLOAD_FPR_RATE_LIMIT_SEC=60
BASILISK_LOOKUP_RATE_LIMIT_SEC=0
BASILISK_SENDTOKEN_RATE_LIMIT_SEC=3600
BASILISK_REQUIRE_MANAGER_APPROVAL=0
BASILISK_REQUIRE_PROOF=0
BASILISK_PROOF_DIFFICULTY=0
BASILISK_PROOF_MAX_AGE_SEC=300
# Client-direct upstream HKP (browser fetches; Basilisk does not proxy)
BASILISK_UPSTREAM_ENABLED=0
BASILISK_UPSTREAM_ALLOWLIST=keys.openpgp.org,keys.mailvelope.com
BASILISK_UPSTREAM_DEFAULT=keys.openpgp.org
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
SERVICE_BUS_NAMESPACE=

# Quorum signalling (Azure Web PubSub). Unset with BASILISK_DEV_APPROVE=1 falls
# back to the local double on 127.0.0.1:8081, which `python -m basilisk.serve`
# starts. Unset in production means /api/v1/quorum/negotiate answers 503.
AZURE_WEBPUBSUB_CONNECTION_STRING=
BASILISK_WEBPUBSUB_HUB=quorum
BASILISK_WEBPUBSUB_TOKEN_TTL_SEC=300

# TURN relay fallback (Cloudflare Realtime). Unset is the shipped state and
# there is no default relay: unset means /api/v1/turn/credentials answers 503
# and a connection that cannot be made directly simply fails. Both halves are
# required. The key is a long-term secret that mints unlimited credentials —
# Cloudflare's instruction is to keep it server-side, and this app never sends
# it to the browser; the endpoint mints a short-lived credential per failure.
#
# Even with a key set, no relay is contacted until a user turns on the relay
# fallback in toolkit preferences *and* a connection reaches `failed`.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
BASILISK_TURN_TTL_SEC=600
